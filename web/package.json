{
  "name": "diskdoctor-web",
  "private": true,
  "version": "0.1.0",
  "description": "DevDoctor desktop shell and web UI",
  "author": "Shamil",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "electron:dev": "electron electron/main.mjs",
    "backend:build": "cd .. && uv run python scripts/build_backend.py",
    "electron:pack": "npm run build && npm run backend:build && node electron/check-backend-bundle.mjs && electron-builder --config electron-builder.json --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "openapi-typescript http://127.0.0.1:8731/openapi.json -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-virtual": "^3.5.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7",
    "simple-icons": "^16.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^24.1.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
