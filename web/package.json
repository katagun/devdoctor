{
  "name": "devdoctor-web",
  "private": true,
  "packageManager": "bun@1.4.0",
  "version": "0.1.0",
  "description": "DevDoctor desktop shell and web UI",
  "author": "embark-delve",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "electron:dev": "electron electron/main.mjs",
    "backend:build": "cd .. && uv run --extra dev --extra web python scripts/build_backend.py",
    "electron:pack": "bun run build && bun run backend:build && node electron/check-backend-bundle.mjs && electron-builder --config electron-builder.json --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "openapi-typescript http://127.0.0.1:8731/openapi.json -o src/api/types.gen.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-virtual": "^3.5.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7",
    "simple-icons": "^16.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.44.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^24.1.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
